{
  "name": "playwright-llm-eval-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright + TypeScript evaluation harness for an LLM support chatbot: golden dataset, model-graded checks, prompt-injection tests, seeded defects, API + E2E coverage.",
  "scripts": {
    "app": "tsx app/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=api --project=e2e --project=security",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:security": "playwright test --project=security",
    "test:eval": "playwright test --project=eval",
    "defects": "tsx scripts/run-defects.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
