# mock = deterministic offline provider (default, used in CI on every push)
# anthropic = real model (needs ANTHROPIC_API_KEY or an `ant auth login` profile)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
BOT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
PORT=3000
# Comma-separated seeded defects to switch on (see app/src/defects.ts)
DEFECTS=
